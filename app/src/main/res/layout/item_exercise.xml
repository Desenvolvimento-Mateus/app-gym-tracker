<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:baselineAligned="false"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <TextView
        android:id="@+id/order_number"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_order_number"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="center"
        android:textColor="@color/accent"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="01" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/exercise_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Supino reto" />

        <TextView
            android:id="@+id/exercise_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/jetbrains_mono"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="4 × 10 · 40 kg" />

        <include
            android:id="@+id/muscle_group_chip"
            layout="@layout/view_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_forward"
        app:tint="@color/text_secondary" />
</LinearLayout>
